# Copy to apps/web/.env.local (gitignored) and fill in.

# Anthropic API key. Required for real AI responses.
# In development, if this is unset the API runs in mock mode automatically.
# In production, if this is unset the AI endpoints return 503.
ANTHROPIC_API_KEY=

# Set to 1 to force canned, deterministic mock responses (no API calls, no cost),
# even when a key is present. Useful for building UI.
AI_MOCK=

# Optional model overrides. Defaults come from MODEL_ROLES in @antelope/core.
# AI_MODEL_ROLEPLAYER=claude-sonnet-5-5
# AI_MODEL_OBSERVER=claude-opus-5-5
# AI_MODEL_COACH=claude-opus-5-5
# AI_MODEL_DRILL=claude-sonnet-5-5

# Optional thinking-depth overrides per role (low | medium | high).
# Defaults: roleplayer low, observer low, coach low, drill low.
# AI_MODEL_ROLEPLAYER_EFFORT=low
# AI_MODEL_OBSERVER_EFFORT=low
# AI_MODEL_COACH_EFFORT=medium
# AI_MODEL_DRILL_EFFORT=low

# Production CORS allowlist (comma-separated origins). Development reflects any
# origin (Expo web on :8081, LAN IPs). The native app sends no Origin header and
# is unaffected.
# CORS_ORIGINS=https://app.example.com,https://affirming-antelope.example.com

# Set to 0 to silence per-call token/latency logging.
# AI_LOG_USAGE=1

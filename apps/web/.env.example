# Copy to apps/web/.env.local (gitignored) and fill in.

# Anthropic API key. Required for real AI responses.
# In development, if this is unset the API runs in mock mode automatically.
# In production, if this is unset the AI endpoints return 503.
ANTHROPIC_API_KEY=

# LEGACY shared app token (TODO(2026-10-25): remove). The AI routes now require a
# Supabase access token (guests are anonymous users; docs/anonymous-auth.md). Until
# 2026-10-25, a request with `x-antelope-key: <APP_CLIENT_TOKEN>` and no bearer token
# is still accepted with a tiny durable per-IP quota, so already-open sessions keep
# working. Needs SUPABASE_SECRET_KEY. Unset = no legacy path.
APP_CLIENT_TOKEN=
# 1 = accept the legacy token, 0 = refuse it. Unset: on until 2026-10-25, then off.
# ALLOW_LEGACY_APP_TOKEN=1

# Set to 1 to force canned, deterministic mock responses (no API calls, no cost),
# even when a key is present. Useful for building UI.
AI_MOCK=

# Optional model overrides. Defaults come from MODEL_ROLES in @antelope/core.
# AI_MODEL_ROLEPLAYER=claude-sonnet-5-5
# AI_MODEL_OBSERVER=claude-opus-5-5
# AI_MODEL_COACH=claude-opus-5-5
# AI_MODEL_DRILL=claude-sonnet-5-5

# Optional thinking-depth overrides per role (low | medium | high).
# Defaults: roleplayer low, observer low, coach low, drill low.
# AI_MODEL_ROLEPLAYER_EFFORT=low
# AI_MODEL_OBSERVER_EFFORT=low
# AI_MODEL_COACH_EFFORT=medium
# AI_MODEL_DRILL_EFFORT=low

# Production CORS allowlist (comma-separated origins). Development reflects any
# origin (Expo web on :8081, LAN IPs). The native app sends no Origin header and
# is unaffected.
# CORS_ORIGINS=https://app.example.com,https://affirming-antelope.example.com

# Set to 0 to silence per-call token/latency logging.
# AI_LOG_USAGE=1

# Supabase (trainer dashboard at /trainer, and bearer-token auth + quotas on the AI API).
# Local: `supabase start` at the repo root prints both (the publishable key is a
# public local default). Hosted: Project Settings > API. The publishable key is
# safe in the browser; every query runs through RLS as the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_..., Settings > API Keys), SERVER ONLY: never prefix
# with NEXT_PUBLIC_. Bypasses RLS. Used only by POST /api/account/merge-anonymous and
# the legacy app-token quota; both return 503 without it. The legacy JWT
# SUPABASE_SERVICE_ROLE_KEY also works. Local: `supabase status` (a public local default).
SUPABASE_SECRET_KEY=
